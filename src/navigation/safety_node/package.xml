<?xml version="1.0"?>
<package format="3">
  <name>safety_node</name>
  <version>0.0.0</version>
  <description>Drive watchdog and mux configuration for autonomous safety stops.</description>
  <maintainer email="fsae@ualberta.ca">UAlbertaFSAE</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <exec_depend>ackermann_mux</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
