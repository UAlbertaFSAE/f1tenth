// Project-scoped settings only. Anything here should be something the repo
// needs in order to work correctly -- interpreter, formatters, lint config,
// excludes. Personal preferences belong in your user settings, not here.
//
// Paths are relative to the repo, which is the workspace's src/ directory, so
// the workspace root (build/, install/, log/, venv/) is one level up.
{
  // ---- Python -----------------------------------------------------------
  // The venv `make deps` creates, at the workspace root.
  "python.defaultInterpreterPath": "${workspaceFolder}/../venv/bin/python",
  "python.analysis.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],
  "python.autoComplete.extraPaths": [
    "/opt/ros/humble/lib/python3.10/site-packages",
    "/opt/ros/humble/local/lib/python3.10/dist-packages"
  ],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // Same config file `make lint` and CI use, so the editor cannot disagree
  // with either of them.
  "ruff.configuration": "${workspaceFolder}/pyproject.toml",
  "mypy-type-checker.args": ["--config-file=${workspaceFolder}/pyproject.toml"],

  // ---- C++ --------------------------------------------------------------
  // clangd is the only C++ language server here. The Microsoft IntelliSense
  // engine is disabled rather than left to fight with it: two engines reading
  // two different configs produce phantom errors nobody can explain.
  "C_Cpp.intelliSenseEngine": "disabled",
  "[cpp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.detectIndentation": false,
    "editor.tabSize": 2
  },

  // ---- ROS --------------------------------------------------------------
  "ros.distro": "humble",
  "files.associations": {
    "*.launch.py": "python",
    "*.launch": "xml",
    "package.xml": "xml",
    "*.rviz": "yaml",
    "*.urdf": "xml",
    "*.xacro": "xml"
  },

  // ---- Excludes ---------------------------------------------------------
  // Without these VS Code indexes the entire build tree and becomes unusable.
  "search.exclude": {
    "**/build": true,
    "**/install": true,
    "**/log": true,
    "**/venv": true,
    "**/__pycache__": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/install/**": true,
    "**/log/**": true,
    "**/venv/**": true
  },

  // ---- Editor hygiene the linters enforce anyway -------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true
}
