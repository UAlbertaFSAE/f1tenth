FROM ros:humble

# Same root convention as Dockerfile.dev: /f1tenth is the colcon workspace root
# and the repo is /f1tenth/src, so the Makefile resolves the same way here, in
# the dev image, and on a bare-metal checkout.
ARG WORKSPACE=/f1tenth

SHELL ["/bin/bash", "-c"]

# install apt packages
COPY docker/deps/packages.txt deps/packages.txt
COPY docker/deps/packages-jetson.txt deps/packages-jetson.txt
RUN apt update && apt install -q -y --no-install-recommends \
    $(cat deps/packages.txt) \
    $(cat deps/packages-jetson.txt) \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# install clang tooling (version 18)
RUN wget https://apt.llvm.org/llvm.sh \
    && chmod +x llvm.sh \
    && ./llvm.sh 18 \
    && rm -f llvm.sh \
    && apt update && apt install -y \
    clang-tools-18 \
    clang-tidy-18 \
    clang-format-18 \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# install the Jetson-only python packages; the rest come from `make deps`
COPY docker/deps/requirements-jetson.txt deps/requirements-jetson.txt
RUN python3 -m pip install --upgrade pip \
    && python3 -m pip install --upgrade --ignore-installed -r deps/requirements-jetson.txt

# install ZED SDK
RUN apt-get -q -y update && apt-get install -q -y --no-install-recommends lsb-release wget less udev sudo apt-transport-https zstd && \
    wget -q --no-check-certificate -O ZED_SDK_Linux.run https://download.stereolabs.com/zedsdk/4.1/l4t35.3/jetsons && \
    chmod +x ZED_SDK_Linux.run ; ./ZED_SDK_Linux.run silent skip_tools && \
    rm -rf /usr/local/zed/resources/* && \
    rm -rf ZED_SDK_Linux.run && \
    rm -rf /var/lib/apt/lists/* && apt-get clean

COPY . ${WORKSPACE}/src

# The ZED SDK is present in this image, so the car's image builds the ZED
# packages too rather than the PACKAGES_IGNORE default.
WORKDIR ${WORKSPACE}/src
RUN make deps && make build_all

RUN git config --global --add safe.directory ${WORKSPACE}/src
RUN git config --global user.email "formula@ualberta.ca"
RUN git config --global user.name "formula"

ENTRYPOINT [ "/bin/bash" ]
