FROM ros:humble

# using devcontainer is nice cause it'll remap uid's/gid's for us
ARG USERNAME=autonomous
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

SHELL ["/bin/bash", "-c"]

# Create the user
RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} \
    && apt update \
    && apt install -y sudo \
    && echo ${USERNAME} ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# install apt packages (editor/tooling + extra ROS packages not covered by rosdep)
COPY docker/deps/packages.txt /tmp/deps/packages.txt
RUN apt update && apt install -q -y --no-install-recommends \
    $(cat /tmp/deps/packages.txt) \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

# install clang tooling (version 18)
RUN wget https://apt.llvm.org/llvm.sh \
    && chmod +x llvm.sh \
    && ./llvm.sh 18 \
    && apt update && apt install -y \
    clang-tools-18 \
    clang-tidy-18 \
    clang-format-18 \
    && rm -f llvm.sh

RUN apt-get update && apt-get install -y \
        qt6-base-dev \
        qt6-base-dev-tools \
        qt6-tools-dev \
        qmake6 \
        build-essential \
        python3-dev \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

ENV IS_JETSON=FALSE

# The workspace root (WS_ROOT/FORMULA_HOME) is /f1tenth; the git repo lives at
# /f1tenth/src, one level below. This matches the bare-metal layout so
# `make deps`/`make build` (which resolve WS_ROOT from the Makefile's own
# location) behave identically in and out of the container. At runtime the
# devcontainer bind-mounts a live checkout over /f1tenth/src only, so the
# venv/build/install baked in here by `make deps`/`make build` below live
# undisturbed at /f1tenth and are never wiped by that mount.
COPY --chown=${USER_UID}:${USER_GID} . /f1tenth/src
RUN git config --system --add safe.directory /f1tenth/src

USER ${USERNAME}
WORKDIR /f1tenth/src

# Full environment setup (system/rosdep/venv deps) then a full colcon build,
# baked into the image so the devcontainer is ready to use immediately.
RUN make deps
RUN make build

ENTRYPOINT [ "/bin/bash" ]
